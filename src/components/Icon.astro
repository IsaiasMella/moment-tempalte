---
/**
 * One icon, by name.
 *  - UI icons (sun, moon, menu, close, arrows) are stroked 24×24 line icons;
 *    `size` sets their width/height in px.
 *  - Social icons are Bootstrap Icons (src/lib/icons.ts), drawn inside a span
 *    that sizes them with Tailwind classes passed in `class` (e.g. "h-4 w-4").
 * Icons are decorative (aria-hidden): give the surrounding link/button a label.
 * React/Next.js equivalent: an icon component such as lucide-react's <Icon />.
 */
import { socialIcons } from '../lib/icons';
import type { SocialPlatform } from '../lib/schemas';

/** Inner markup of the UI icons (viewBox 0 0 24 24). */
const uiIcons = {
  sun: '<circle cx="12" cy="12" r="4"></circle><path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"></path>',
  moon: '<path d="M20 14.2A7.4 7.4 0 0 1 9.8 4a8.6 8.6 0 1 0 10.2 10.2Z"></path>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"></path>',
  close: '<path d="m6 6 12 12M18 6 6 18"></path>',
  'arrow-left': '<path d="M19 12H6m6-6-6 6 6 6"></path>',
  'arrow-right': '<path d="M5 12h13m-6-6 6 6-6 6"></path>',
};
export type UiIcon = keyof typeof uiIcons;

interface Props {
  name: UiIcon | SocialPlatform;
  /** UI icons only: width and height in px. */
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
const isUi = (value: string): value is UiIcon => value in uiIcons;
---
{
  isUi(name) ? (
    <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={uiIcons[name]} />
  ) : (
    <span class:list={['inline-grid place-items-center [&>svg]:h-full [&>svg]:w-full [&>svg]:fill-current', className]} aria-hidden="true" set:html={socialIcons[name]} />
  )
}
