---
/**
 * A gallery of photographs packed into justified rows (src/scripts/gallery.ts),
 * each opening in the lightbox scoped to this gallery's `group`.
 *
 * React/Next.js equivalent: a <Gallery photos={[…]} /> client component whose
 * layout runs in a useEffect; here the script is bundled once for the page.
 */
import type { Photo } from './types';

interface Props {
  photos: Photo[];
  caption?: string;
  group: string;
  sizes?: string;
}

const { photos, caption, group, sizes = '(min-width: 64rem) 34vw, (min-width: 40rem) 48vw, 94vw' } = Astro.props;
---
<figure class="gallery" aria-label="Gallery"><div class="gallery-rows" data-gallery>{photos.map((photo, index) => (
  <button class="gallery-frame" type="button" data-lightbox data-lightbox-group={group} data-lightbox-src={photo.src} data-lightbox-srcset={photo.lightboxSrcset ?? photo.srcset} data-lightbox-alt={photo.alt} data-lightbox-caption data-lightbox-credit aria-label={`Enlarge photograph ${index + 1} of ${photos.length}: ${photo.alt}`}><img src={photo.src} srcset={photo.srcset} alt={photo.alt} sizes={sizes} loading="lazy" decoding="async" data-autosize="true" width={photo.width} height={photo.height} /></button>
))}</div>{caption && <figcaption class="gallery-caption">{caption}</figcaption>}</figure>

<script>
  import '../../scripts/gallery';
</script>
