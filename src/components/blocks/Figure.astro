---
/**
 * A photograph in a story or long-form page, with an optional caption. Clicking it
 * opens the lightbox (Lightbox.astro) with every photo of the same `group`.
 * `size`: "regular" = reading column, "wide" = breaks out of it, "full" = window edge.
 *
 * React/Next.js equivalent: a <Figure photo={…} caption="…" /> wrapping next/image.
 */
import type { Photo } from './types';

interface Props {
  photo: Photo;
  caption?: string;
  size?: 'regular' | 'wide' | 'full';
  /** Lightbox group name. */
  group?: string;
  /** Candidate widths hint; replaced at runtime by src/scripts/autosize.ts. */
  sizes?: string;
}

const { photo, caption = '', size = 'regular', group = 'story', sizes } = Astro.props;
---
<figure class:list={['card', { 'card-wide': size === 'wide', 'card-full': size === 'full' }]}><button class="figure-frame" type="button" data-lightbox data-lightbox-group={group} data-lightbox-src={photo.src} data-lightbox-srcset={photo.lightboxSrcset ?? photo.srcset} data-lightbox-alt={photo.alt} data-lightbox-caption={caption} data-lightbox-credit aria-label={`Enlarge photograph: ${photo.alt}`}><img src={photo.src} srcset={photo.srcset} alt={photo.alt} sizes={sizes} loading="lazy" decoding="async" data-autosize="true" width={photo.width} height={photo.height} /></button>{caption && <figcaption class="figure-caption">{caption}</figcaption>}</figure>
