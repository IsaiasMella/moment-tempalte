---
/**
 * /story/<slug>/ — one page per published album in src/content/albums/<slug>.md.
 *
 * `getStaticPaths()` lists the pages to build (one per album) and passes each
 * one its album as a prop; the page then composes the album components:
 * hero → content blocks → tags & share → related albums → next album.
 *
 * React/Next.js equivalent: app/story/[slug]/page.tsx with
 * `generateStaticParams()` (+ `generateMetadata()` for the SEO props below).
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlbumHero from '../../components/album/AlbumHero.astro';
import Blocks from '../../components/album/Blocks.astro';
import NextAlbum from '../../components/album/NextAlbum.astro';
import PostFooter from '../../components/album/PostFooter.astro';
import RelatedAlbums from '../../components/album/RelatedAlbums.astro';
import ShareSheet from '../../components/album/ShareSheet.astro';
import { categoryUrl } from '../../lib/archive';
import { getAlbums, getSiteSettings, type AlbumEntry } from '../../lib/content';
import { getImageData } from '../../lib/images';
import { absoluteUrl, breadcrumbJsonLd, websiteJsonLd } from '../../lib/site';

export const getStaticPaths = (async () => {
  const albums = await getAlbums();
  return albums.map((album) => ({ params: { slug: album.slug }, props: { album, albums } }));
}) satisfies GetStaticPaths;

interface Props {
  album: AlbumEntry;
  /** All published albums, newest first (for "More …" and "Next"). */
  albums: AlbumEntry[];
}

const { album, albums } = Astro.props;
const settings = await getSiteSettings();
const site = Astro.site ?? Astro.url;
const url = absoluteUrl(album.url, site);
const description = album.description ?? album.lede;

// Social card: the cover's 1200×630 JPEG (pre-rendered or generated by story/media/[file].ts).
const cover = await getImageData(album.cover.src);
const ogImage = cover.og ?? cover.src;
const published = album.date;
const modified = album.updated ?? album.date;

const article: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['Article', 'ImageGallery'],
  headline: album.title,
  description,
  image: absoluteUrl(ogImage, site),
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  datePublished: published.toISOString(),
  dateModified: modified.toISOString(),
  author: { '@type': 'Person', name: settings.photographer },
  publisher: websiteJsonLd(settings, site).publisher,
  articleSection: album.categoryLabel,
  keywords: album.tags,
  inLanguage: 'en',
  isAccessibleForFree: true,
};
if (album.location) article.contentLocation = { '@type': 'Place', name: album.location };
const breadcrumbs = breadcrumbJsonLd(settings, site, [
  { name: album.categoryLabel, path: categoryUrl(album.category) },
  { name: album.title, path: album.url },
]);
---
<BaseLayout
  title={album.title}
  description={description}
  ogImage={ogImage}
  ogImageAlt={album.cover.alt}
  ogImageMeta={cover.og ? { type: 'image/jpeg', width: 1200, height: 630 } : undefined}
  ogType="article"
  article={{ publishedTime: published, modifiedTime: modified, section: album.categoryLabel, tags: album.tags }}
  jsonLd={[article, breadcrumbs]}
  header={album.layout === 'note' ? 'default' : 'over'}
>
  <article>
    <AlbumHero album={album} />
    <div class="wrap"><Blocks blocks={album.blocks} /></div>
    <PostFooter album={album} url={url} />
  </article>
  <RelatedAlbums album={album} albums={albums} />
  <NextAlbum album={album} albums={albums} />
  <ShareSheet title={album.title} url={url} />
</BaseLayout>
