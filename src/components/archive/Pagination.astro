---
/**
 * Numbered pagination for a listing, from Astro's `paginate()` page object:
 * « Previous · 1 2 3 · Next ». Renders nothing when there is a single page.
 *
 *   <Pagination page={page} base="/work" label="Work" />
 *
 * React/Next.js equivalent: a <Pagination> fed by the page number from the route params.
 */
import type { Page } from 'astro';
import Icon from '../Icon.astro';

interface Props {
  page: Page<unknown>;
  /** URL of page 1 without the trailing slash, e.g. "/collection/weddings". */
  base: string;
  /** Accessible name prefix: "<label> pagination". */
  label: string;
}

const { page, base, label } = Astro.props;
const href = (n: number) => (n === 1 ? `${base}/` : `${base}/${n}/`);
---
{page.lastPage > 1 && (
  <nav class="pagination" aria-label={`${label} pagination`}><div class="pagination-side">{page.url.prev && <a class="btn btn-outline btn-sm" href={page.url.prev} rel="prev"><Icon name="arrow-left" size={12} /><span>Previous</span></a>}</div><div class="pagination-pages">{Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => n === page.currentPage
    ? <span class="pagination-current" aria-current="page">{n}</span>
    : <a class="pagination-page" href={href(n)} aria-label={`Page ${n}`}>{n}</a>)}</div><div class="pagination-side">{page.url.next && <a class="btn btn-outline btn-sm" href={page.url.next} rel="next"><span>Next</span><Icon name="arrow-right" size={12} /></a>}</div></nav>
)}
