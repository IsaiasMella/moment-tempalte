---
// Sveltia CMS panel. Lives in src/pages so the catch-all route does not shadow /admin/ in dev.
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Moments · Panel</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- La configuración está en ./config.yml (se carga automáticamente). -->
  </head>
  <body>
    <!-- Sveltia CMS: https://sveltiacms.app · Guía: docs/CMS.md -->
    <script is:inline src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js"></script>
    <!-- Vista previa de álbumes con el diseño real. -->
    <script is:inline src="/admin/preview.js"></script>
  </body>
</html>
