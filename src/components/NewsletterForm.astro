---
/**
 * Footer mailing-list signup. It only submits when a provider endpoint is set in
 * the settings (`forms.newsletterAction`); until then the button is disabled and a
 * note explains why, exactly like the original theme.
 * React/Next.js equivalent: a <form action={endpoint}> component (no client JS).
 */
import { getSiteSettings } from '../lib/content';

const { footer, forms } = await getSiteSettings();
const action = forms.newsletterAction || undefined;
---
<form class="subscribe-form" action={action} method="post" aria-describedby={action ? undefined : 'footer-signup-note'}><div><label class="sr-only" for="footer-signup">Email address</label><input id="footer-signup" class="field" type="email" name="email" autocomplete="email" placeholder={footer.signupPlaceholder} required /></div><button type="submit" class="btn btn-accent" disabled={!action}><span>{footer.signupButton}</span></button>{!action && <p id="footer-signup-note" class="form-note">Set a newsletter provider in src/config/site.ts to start collecting these.</p>}</form>
