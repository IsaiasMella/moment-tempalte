---
import { referencePages, renderReference } from '../lib/reference';
import { applyTransforms, isGeneratedRoute } from '../lib/transforms';

export function getStaticPaths() {
  return referencePages()
    .filter(({ route }) => !isGeneratedRoute(route))
    .map(({ route, file }) => ({
      params: { path: route.replace(/\/$/, '') || undefined },
      props: { route, file },
    }));
}

const { route, file } = Astro.props;
const html = await applyTransforms(route, renderReference(file, Astro.site?.origin ?? Astro.url.origin));
---
<Fragment set:html={html} />
