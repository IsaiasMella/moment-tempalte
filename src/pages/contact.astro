---
/**
 * /contact/ — content from src/content/pages/contact.yml plus the site settings:
 * the email address, text sections, contact details (based, phone when set,
 * social links) and the enquiry form (ContactForm.astro).
 * React/Next.js equivalent: app/contact/page.tsx composing <ContactForm />.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import PageHead from '../components/PageHead.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getPage, getSiteSettings } from '../lib/content';
import { breadcrumbJsonLd } from '../lib/site';

const page = await getPage('contact');
const settings = await getSiteSettings();
const jsonLd = breadcrumbJsonLd(settings, Astro.site ?? Astro.url, [{ name: page.title, path: '/contact/' }]);

/** Splits a text field into paragraphs on blank lines. */
const paragraphs = (text: string) => text.split(/\n\s*\n/).map((part) => part.trim()).filter(Boolean);
const based = [settings.location, settings.locationNote].filter(Boolean);
const tel = settings.phone.replace(/[^\d+]/g, '');
---
<BaseLayout title={page.seo.title} description={page.seo.description || undefined} jsonLd={jsonLd}>
  <PageHead title={page.title} lede={page.lede} />
  <section class="wrap wrap-mid contact-section"><div class="contact-layout"><div class="contact-intro"><div class="prose prose-page">{settings.email && <><h2>{page.emailHeading}</h2><p><a href={`mailto:${settings.email}`}>{settings.email}</a></p></>}{page.sections.map((section) => <>{section.heading && <h2>{section.heading}</h2>}{paragraphs(section.text).map((text) => <p>{text}</p>)}</>)}</div><aside class="contact-aside">{based.length > 0 && <dl class="contact-detail"><dt>{page.basedLabel}</dt>{based.map((line) => <dd>{line}</dd>)}</dl>}{settings.phone && <dl class="contact-detail"><dt>{page.phoneLabel}</dt><dd><a href={`tel:${tel}`}>{settings.phone}</a></dd></dl>}{settings.socials.length > 0 && <dl class="contact-detail"><dt>{page.followLabel}</dt><dd class="contact-socials"><SocialLinks iconClass="h-5 w-5" /></dd></dl>}</aside></div><ContactForm labels={page.form} action={settings.forms.enquiryAction} /></div></section>
</BaseLayout>

<style>
  .contact-section {
    padding-bottom: var(--space-section);
  }
  .contact-layout {
    gap: clamp(2.5rem, 5vw, 4.5rem);
    display: grid;
  }
  @media (width >= 64rem) {
    .contact-layout {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .contact-intro {
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
    display: flex;
  }
  .contact-intro .prose {
    max-width: 34rem;
  }
  .contact-aside {
    border-top: var(--rule-thin);
    flex-wrap: wrap;
    gap: 2rem 3rem;
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
  }
  .contact-detail dt {
    color: var(--muted-foreground);
    font-family: var(--font-label);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 0.375rem;
    font-size: 0.625rem;
  }
  .contact-detail dd {
    margin: 0;
  }
  .contact-socials {
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-left: -0.5rem;
    display: flex;
  }
</style>
