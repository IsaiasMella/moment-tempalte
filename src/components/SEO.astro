---
/**
 * Everything search engines and social previews read: <title>, description,
 * canonical URL, robots, Open Graph, Twitter card and JSON-LD structured data.
 * Relative paths are made absolute with `Astro.site` (the SITE_URL origin).
 * React/Next.js equivalent: the `metadata` export / generateMetadata() in app/*.tsx.
 */
interface Props {
  /** Full document title, e.g. "Privacy | Moments". */
  title: string;
  description: string;
  siteName: string;
  /** Path or URL of the canonical page (defaults to the current URL). */
  canonical?: string;
  /** Path or URL of the social preview image. */
  image: string;
  imageAlt: string;
  /** Optional Open Graph image details (stories set these). */
  imageMeta?: { type: string; width: number; height: number };
  /** "article" adds the article:* tags below. */
  type?: 'website' | 'article';
  article?: { publishedTime: Date; modifiedTime?: Date; section?: string };
  /** Keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
  /** One or more schema.org objects. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, siteName, canonical, image, imageAlt, imageMeta, type = 'website', article, noindex = false, jsonLd } = Astro.props;

const site = Astro.site ?? Astro.url;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
/** `<` escaped so JSON inside <script> can never close the tag. */
const jsonLdBlocks = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map((data) => JSON.stringify(data).replace(/</g, '\\u003c'));
---
<title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonicalUrl} />{noindex && <meta name="robots" content="noindex, nofollow" />}<meta property="og:locale" content="en_GB" /><meta property="og:type" content={type} /><meta property="og:site_name" content={siteName} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalUrl} /><meta property="og:image" content={imageUrl} /><meta property="og:image:alt" content={imageAlt} />{imageMeta && <><meta property="og:image:type" content={imageMeta.type} /><meta property="og:image:width" content={String(imageMeta.width)} /><meta property="og:image:height" content={String(imageMeta.height)} /></>}{article && <><meta property="article:published_time" content={article.publishedTime.toISOString()} /><meta property="article:modified_time" content={(article.modifiedTime ?? article.publishedTime).toISOString()} />{article.section && <meta property="article:section" content={article.section} />}</>}<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={imageUrl} /><meta name="twitter:image:alt" content={imageAlt} />{jsonLdBlocks.map((json) => <script type="application/ld+json" set:html={json} />)}
